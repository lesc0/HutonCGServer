# cg-editor 프로덕션 실행 설정 (prod 모드에서 .env 위에 덮어씀)
# 앱 코드가 직접 읽는 환경변수는 없고, 실행 스크립트(next start)의 포트·주소만 지정한다.
# 비밀값(토큰 등)은 여기에 넣지 말 것.

# 접속 포트 (start 의 --port / /port 옵션이 있으면 그쪽이 우선)
CG_EDITOR_PORT=8080

# 접속 허용 주소. 기본 127.0.0.1(이 PC 전용). 다른 PC 에서 접속하려면 0.0.0.0
# (start 의 --host / /host 옵션이 있으면 그쪽이 우선)
# CG_EDITOR_HOST=0.0.0.0
