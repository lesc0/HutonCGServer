# cg-editor 공통 설정 (start.sh / start.bat 이 개발·프로덕션 모두에서 읽음)
# 적용 순서: .env -> (prod 모드면) .env.production 이 덮어씀 -> start 의 --port/--host 옵션이 최우선
# 비밀값(토큰 등)은 여기에 넣지 말 것.

# 에디터 접속 포트 (개발 서버 기본 5173)
CG_EDITOR_PORT=5173

# 접속 허용 주소. 기본 127.0.0.1(이 PC 전용). 다른 PC 에서 접속하려면 0.0.0.0
# (지정하면 파일 서버도 같은 주소로 열림)
# CG_EDITOR_HOST=0.0.0.0

# 파일 서버: 에디터가 bin/media 에서 이미지·영상·음성을 가져오고 bin/project 에 프로젝트 JSON 을 저장할 때 사용
# 포트는 에디터 코드(app/files.ts 의 FILES_PORT)와 같아야 하므로 바꾸려면 둘 다 수정
CG_FILES_PORT=8081
# CG_FILES_HOST=127.0.0.1
# 폴더 위치를 바꿀 때만 (기본: 저장소 루트의 bin/media, bin/project)
# CG_MEDIA_DIR=../../bin/media
# CG_PROJECT_DIR=../../bin/project
