{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "rk3588",
      "displayName": "RK3588 (Debian 12 arm64) - Software OnPaint",
      "description": "기본 경로: CEF OnPaint(CPU BGRA) -> RGA -> MPP H.264. CEF_ROOT 환경변수 필요 (env.md 참고).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/rk3588",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CEF_ROOT": "$env{CEF_ROOT}",
        "ENABLE_ACCEL_PAINT": "OFF"
      }
    },
    {
      "name": "rk3588-accel",
      "displayName": "RK3588 (Debian 12 arm64) - Accel dmabuf (실험)",
      "description": "실험 경로: CEF OnAcceleratedPaint(dmabuf 제로카피) -> RGA -> MPP H.264. --accel 로 실행.",
      "inherits": "rk3588",
      "binaryDir": "${sourceDir}/../../build/rk3588-accel",
      "cacheVariables": {
        "ENABLE_ACCEL_PAINT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "rk3588",
      "configurePreset": "rk3588"
    },
    {
      "name": "rk3588-accel",
      "configurePreset": "rk3588-accel"
    }
  ]
}
